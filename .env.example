APP_NAME=Milaedu
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://milaedu.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── PayOS (BỔ SUNG SAU khi liên kết) ───────────────────────────────
# Lấy tại my.payos.vn → Kênh thanh toán. Để trống thì thanh toán auto chưa chạy.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# ─── Giá (đổi không cần sửa code) ───────────────────────────────────
# PRICE_WEEK = gói 2 tuần · PRICE_MONTH = gói 1 tháng
PRICE_WEEK=399000
PRICE_MONTH=699000
PRICE_GRADING=99000

# Giá trị quy đổi 1 học viên admin thêm tay (offline) — chỉ dùng cho thống kê
# doanh thu tổng của chủ sở hữu. Bỏ trống = 2.000.000đ (default trong code).
# MANUAL_STUDENT_VALUE=2000000

# ─── Tài khoản CHỦ SỞ HỮU (role owner) — ẩn, toàn quyền như admin ──────────
# Đặt rồi chạy: php artisan db:seed --class=OwnerAccountSeeder
# KHÔNG commit giá trị thật. Thiếu 2 dòng này thì seeder bỏ qua.
# OWNER_EMAIL=chu-so-huu@vidu.com
# OWNER_PASSWORD=mat-khau-that-dai-va-manh

# ---------- SEO / nội dung thật (bỏ trống = dùng mặc định trong config/seo.php) ----------
# Bio THẬT của giảng viên (2–3 dòng, hiện ở trang chủ + /gioi-thieu + structured data)
SEO_INSTRUCTOR_BIO=
# Ảnh chân dung THẬT: đặt file vào public/images/ rồi khai đường dẫn.
# Bỏ trống → web tự vẽ ô chữ cái đầu làm placeholder. VD: /images/co-dung.jpg
SEO_INSTRUCTOR_PHOTO=
# Mã xác minh Google Search Console (cách "HTML tag") — chỉ dán phần content,
# không dán cả thẻ <meta>.
SEO_GOOGLE_SITE_VERIFICATION=

# ---------- Chấm bài bằng AI (OpenAI) ----------
# Dùng cho chấm Writing tự động VÀ chấm Nói (phiên âm + chấm transcript).
# Bỏ trống → hệ thống chạy chế độ mock, không gọi API, không tốn tiền.
OPENAI_API_KEY=

# Model phiên âm bài Nói. Tên và giá model OpenAI đổi nhanh nên để ở env,
# đổi được mà không phải sửa code rồi deploy lại.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Công tắc tắt nóng chấm Nói bằng AI. false = bài Nói mới quay về luồng
# giáo viên chấm tay như trước, không cần deploy lại.
SPEAKING_AI_ENABLED=true

# ---------- Công suất chấm AI ----------
# Số worker chạy SONG SONG cho hàng đợi bài Nói (hàng `speaking`).
# Job Nói chủ yếu là CHỜ MẠNG (gọi OpenAI) chứ không ăn CPU, nên song song gần
# như miễn phí kể cả trên shared hosting 2 core. Một worker rút ~3 job/phút.
# Tăng khi hàng đợi tồn mà KHÔNG job nào lỗi (thiếu công suất, không phải bug).
# Hạ xuống nếu hosting kêu vượt số tiến trình. Đổi xong nhớ `config:cache`.
QUEUE_SPEAKING_WORKERS=3

# ---------- Tra từ bằng AI + Sổ tay từ vựng ----------
# false = học viên không bôi chọn tra từ được trong bài, mọi URL /tu-vung* trả
# 404. Dùng để tắt nóng khi chi phí API vọt bất thường. Nhớ `config:cache`.
VOCAB_LOOKUP_ENABLED=true

# Hạn mức lượt tra mỗi học viên mỗi NGÀY (tự làm mới lúc 0h).
# Lượt trúng kho đệm vẫn tính — hạn mức này còn để chặn spam, không chỉ chặn tiền.
VOCAB_DAILY_LIMIT=60

# Bôi dài hơn ngần này coi như chọn nhầm cả đoạn, từ chối trước khi gọi API.
VOCAB_MAX_CHARS=300

# Model tra từ. Tra từ là việc nhẹ, KHÔNG cần model mạnh.
VOCAB_AI_MODEL=gpt-4o-mini

# Số thẻ tối đa trong một phiên ôn tập từ vựng.
VOCAB_REVIEW_BATCH=20

# ---------- Lớp học online (ĐANG HOÃN) ----------
# false = học viên không thấy menu "Lớp học", không thấy thẻ "lớp sắp tới" ở
# dashboard, mọi URL /lop-hoc* trả 404, cron KHÔNG gửi email nhắc giờ.
# Admin vẫn quản lý buổi học bình thường ở /admin/class-sessions.
# Bật lại: đổi thành true rồi `php artisan config:cache`.
CLASSES_ENABLED=false

# ---------- Giới hạn thiết bị (chống chia sẻ tài khoản) ----------
# Bỏ trống hết cũng chạy được — mặc định nằm trong config/devices.php.
# Đổi ở đây thì KHÔNG phải sửa code, chỉ cần `php artisan config:cache`.
#
# Số thiết bị được dùng ĐỒNG THỜI. Vượt số này mới tính là vi phạm.
DEVICE_MAX=2
# Phiên không phát sinh request trong ngần này giờ thì coi như đã rời đi và
# không còn chiếm suất. NGẮN hơn = dễ chia sẻ luân phiên; DÀI hơn = dễ phạt oan
# người đổi máy trong ngày. Đừng để 0 — thành đếm cả lịch sử như lỗi cũ.
DEVICE_ACTIVITY_WINDOW_HOURS=6
# Đủ ngần này vi phạm thì khoá tài khoản. 2 = "cảnh báo lần đầu, cố tình lần nữa thì khoá".
DEVICE_BLOCK_AFTER=2
# Vi phạm cũ hơn ngần này ngày thì bỏ qua, đếm lại từ đầu.
DEVICE_VIOLATION_RESET_DAYS=30
# Dọn phiên không hoạt động quá ngần này ngày (lệnh `sessions:prune`, chạy 04:00 hằng ngày).
DEVICE_PRUNE_AFTER_DAYS=30
